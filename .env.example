SECRET_KEY=replace-with-a-random-string
LOGIN_PASSWORD=replace-with-your-own-password

# Optional - enables the "Email reminders" button. Leave unset to disable it.
# EMAIL_ADDRESS=your-gmail-address@gmail.com
# EMAIL_APP_PASSWORD=your-16-character-gmail-app-password

# Optional - required only for the automatic daily reminder (/reminders/auto).
# Make this a long random string; it acts as a password so only your scheduled
# job can trigger the automatic email.
# REMINDER_TOKEN=replace-with-a-random-string
